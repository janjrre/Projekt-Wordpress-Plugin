{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uop/event-list",
  "version": "0.1.0-alpha.2",
  "title": "Event List",
  "description": "List public events",
  "category": "widgets",
  "icon": "calendar-alt",
  "textdomain": "uop-core",
  "attributes": {
    "limit": {
      "type": "integer",
      "default": 6
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "uop-m6-block-editor",
  "style": "uop-m6-blocks"
}
